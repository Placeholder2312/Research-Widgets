<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aftergleam_tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nothing_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal">

        <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
        <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
        <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_red" />
        <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
        <ImageView android:layout_width="5dp" android:layout_height="5dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:contentDescription="Aftergleam logo"
        android:scaleType="fitCenter"
        android:src="@drawable/aftergleam_brand_mark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:fontFamily="monospace"
        android:importantForAccessibility="no"
        android:letterSpacing="0.14"
        android:text="AFTERGLEAM"
        android:textColor="@color/nothing_muted"
        android:textSize="9sp" />
</FrameLayout>
