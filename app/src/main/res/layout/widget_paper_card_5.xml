<?xml version="1.0" encoding="utf-8"?>
<!--
  StackView measures each card with AT_MOST, so a match_parent card would shrink to its text.
  The oversized minWidth/minHeight make the card fill the full space StackView offers (it is clamped).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/paper_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nothing_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:minWidth="4000dp"
    android:minHeight="4000dp"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/paper_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="5"
            android:textColor="@color/nothing_ink"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/dot_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_0"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

            <ImageView
                android:id="@+id/dot_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

            <ImageView
                android:id="@+id/dot_4"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

            <ImageView
                android:id="@+id/dot_5"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

            <ImageView
                android:id="@+id/dot_6"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nothing_dot_off" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
