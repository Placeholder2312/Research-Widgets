<?xml version="1.0" encoding="utf-8"?>
<!-- Initial layout and empty/offline state of the strip; the paper cards are widget_paper_card*/rail*. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nothing_card_bg"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/empty_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_red" />
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:importantForAccessibility="no" android:src="@drawable/nothing_dot_off" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:maxLines="3"
            android:padding="10dp"
            android:text="NO PAPERS"
            android:textColor="@color/nothing_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
